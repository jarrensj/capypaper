# Postgres connection string for the Supabase database. In production, use the
# transaction pooler (port 6543).
DATABASE_URL=

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Encrypts stored papertrade session keys. Generate with: openssl rand -base64 32
# Changing it makes every stored session key unreadable, so every user has to reconnect.
SESSION_KEY_ENCRYPTION_KEY=

# Optional. Defaults to https://exchange.papertrade.xyz
PAPERTRADE_URL=

# Optional. capypaper's papertrade builder address, once papertrade approves it
# (apply at https://exchange.papertrade.xyz/builders). Session keys registered or
# renewed while it's approved name it, so their closes pay it the builder fee.
# Leave empty to register keys without a builder.
PAPERTRADE_BUILDER_ADDRESS=
